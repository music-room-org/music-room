// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Énumération prisma
// Par quelle méthode le compte a été créé

enum AuthProvider {
  EMAIL
  GOOGLE
  FACEBOOK
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  passwordHash  String?
  AuthProvider  AuthProvider @default(EMAIL)
  emailVerified Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  playlists Playlist[]
  votes Vote[]

  // Public information
  displayName String?
  publicBio   String?
  avatarUrl   String?

  // Friends information
  friendsBio      String?
  friendsLocation String?

  // Private information
  fullName     String?
  phoneNumber  String?
  privateEmail String?

  // Music preferences
  favoriteGenres String[]

  //Live session
  invitedToSessions LiveSession[]


}

model Playlist {
  id        String   @id @default(uuid())
  name      String
  isPublic  Boolean  @default(true)    
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relation : à quel utilisateur appartient cette playlist
  owner   User   @relation(fields: [ownerId], references: [id])
  ownerId String

  playlistTracks PlaylistTrack[]
}

model Track {
  id       String   @id @default(uuid())
  title    String
  artist   String?
  sourceId String
  addedAt  DateTime @default(now())

  // Relation : à quelle playlist ou liveSession appartient ce morceau
  playlistTracks	PlaylistTrack[]
  liveSessionTracks	LiveSessionTrack[]
}

model PlaylistTrack {
	track		Track	@relation(fields: [trackId], references: [id])
	trackId		String
	playlist	Playlist	@relation(fields: [playlistId], references: [id])
	playlistId	String
	position	Int
	addedAt		DateTime @default(now())

  @@id([playlistId, trackId])  
}

model LiveSession {
	id					String		@id @default(uuid())
	name				String
	hostUserId			String
	createdAt			DateTime	@default(now())
	isPublic			Boolean		@default(true)
	//TODO rajouter peut etre date et lieu de la session?

	invitedUsers		User[]

	liveSessionTracks	LiveSessionTrack[]
}

model LiveSessionTrack {
	liveSession		LiveSession	@relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
	liveSessionId	String
	track			Track		@relation(fields: [trackId], references: [id])
	trackId			String
	addedAt			DateTime		@default(now())

	votes			Vote[]
	@@id([liveSessionId, trackId])
}

model Vote {
	createdAt	DateTime		@default(now())

	// Qui vote
	user	User	@relation(fields: [userId], references: [id])
	userId	String

	// Pour quel morceau et quelle session
	liveSessionTrack	LiveSessionTrack	@relation(fields: [liveSessionId, trackId], references: [liveSessionId, trackId], onDelete: Cascade)
	liveSessionId		String
	trackId				String

	// Un même user ne peut voter qu'une fois par morceau par session
	@@id([liveSessionId, trackId,  userId])
}

