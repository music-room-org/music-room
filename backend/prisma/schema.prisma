// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Énumération prisma
// Par quelle méthode le compte a été créé

enum AuthProvider {
  EMAIL
  GOOGLE
  FACEBOOK
}

model User {
  id            String       @id @default(uuid())
  username      String?      @unique
  email         String       @unique
  passwordHash  String?
  AuthProvider  AuthProvider @default(EMAIL)
  emailVerified Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  playlists Playlist[]
  votes Vote[]
  profileImage    String?

  // Public information
  displayName String?
  publicBio   String?
  avatarUrl   String?

  // Friends information
  friendsBio      String?
  friendsLocation String?

  // Private information
  fullName     String?
  phoneNumber  String?
  privateEmail String?

  // Music preferences
  favoriteGenres String[]


}

model Playlist {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relation : à quel utilisateur appartient cette playlist
  owner   User   @relation(fields: [ownerId], references: [id])
  ownerId String

  tracks Track[]
}

model Track {
  id       String   @id @default(uuid())
  title    String
  artist   String?
  sourceId String
  addedAt  DateTime @default(now())

  // Relation : à quelle playlist appartient ce morceau
  playlist   Playlist @relation(fields: [playlistId], references: [id])
  playlistId String
  votes Vote[]
}

model Vote {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // Qui vote
  user   User   @relation(fields: [userId], references: [id])
  userId String

  // Pour quel morceau
  track   Track  @relation(fields: [trackId], references: [id])
  trackId String

  // Un même user ne peut voter qu'une fois par morceau
  @@unique([userId, trackId])

}
